generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model MailingSubscriber {
  id                  Int      @id @default(autoincrement())
  playerName          String
  playerPosition      String
  playerBirthYear     Int
  mostRecentTeam      String
  parentGuardianEmail String   @unique
  createdAt           DateTime @default(now())
}

model Player {
  id            Int            @id @default(autoincrement())
  playerName    String
  age           Int
  position      String
  parentName    String
  email         String
  phone         String
  notes         String?
  createdAt     DateTime       @default(now())
  lessonSignup  LessonSignup?
  clinicSignups ClinicSignup[]
}

model LessonSignup {
  id        Int      @id @default(autoincrement())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  Int      @unique
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model Clinic {
  id          Int            @id @default(autoincrement())
  name        String
  date        DateTime
  time        String
  location    String
  ageGroup    String
  maxPlayers  Int            @default(20)
  description String?
  signups     ClinicSignup[]
  createdAt   DateTime       @default(now())
}

model ClinicSignup {
  id        Int      @id @default(autoincrement())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  Int
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  clinicId  Int
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@unique([playerId, clinicId])
}
